# ReMem enterprise stack — environment for deploy/compose.yaml
# Copy to deploy/.env and fill in.

# --- Neo4j ---
NEO4J_PASSWORD=changeit

# --- MCP HTTP server ---
PORT=3100

# LLM provider: any OpenAI-compatible endpoint (AI Hive, OpenAI, …).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://hive.requrv.ai/api/v1

# Principals: one entry per API key.
#   key      — the bearer token the agent sends (Authorization: Bearer <key>)
#   name     — display name (surfaced by mem_status)
#   tenant   — the principal's PERSONAL tenant
#   company  — the shared COMPANY tenant (read for all, write for admins)
#   role     — "user" | "admin"
MCP_USERS=[{"key":"rk-alice","name":"alice","tenant":"acme-alice","company":"acme-corp","role":"user"},{"key":"rk-ops","name":"ops-bot","tenant":"acme-ops","company":"acme-corp","role":"admin"}]
