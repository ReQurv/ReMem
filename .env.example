# --- Vector store (Qdrant, remote REST) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Graph store (Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeit

# --- MCP HTTP server (remem-mcp service in docker-compose.yaml) ---
PORT=3100
# Principals: one entry per user. key = bearer token the agent sends, tenant =
# personal tenant, company = shared tenant, role = "user" | "admin".
# The default below works out of the box (one local user, admin); edit as needed.
MCP_USERS=[{"key":"rk-local","name":"local","tenant":"personal","company":"shared","role":"admin"}]

# --- Providers: 'openai' | 'ollama' (optional override; default = openai if
#     OPENAI_API_KEY is set, else ollama) ---
# EMBEDDER_PROVIDER=openai
# CHAT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://hive.requrv.ai/api/v1   # any OpenAI-compatible endpoint
OPENAI_EMBED_MODEL=requrv-embed
# Only for custom models: pin the vector size (otherwise probed once at connect).
# EMBEDDING_DIMENSIONS=4096
OLLAMA_BASE_URL=http://localhost:11434   # from docker-compose, point at the host: http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Chat provider: 'openai' | 'ollama' ---
OPENAI_CHAT_MODEL=requrv-small-3.8
OLLAMA_CHAT_MODEL=llama3.1

# --- Tenant (optional): one ReMem instance = one tenant. When set, all data
# (memories, index, graph) is scoped to it. Omit for single-tenant mode. ---
# TENANT=acme

# --- Router (optional): 'heuristic' (default) | 'llm' | 'laya' ---
# ROUTER=heuristic
# LAYA_ENDPOINT=http://localhost:8080/predict
# LAYA_CHECKPOINT=
# LAYA_THRESHOLD=0.5
# LAYA_TIMEOUT_MS=800

# --- Index sources (optional) ---
# Local folder indexed by examples/recall-index.ts
# INDEX_LOCAL_ROOT=/path/to/folder
# S3 / MinIO
S3_BUCKET=
S3_PREFIX=
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=            # for MinIO, e.g. http://localhost:9000 (+forcePathStyle)
# WebDAV / Nextcloud
WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/utente
WEBDAV_USER=
WEBDAV_PASSWORD=
WEBDAV_PREFIX=
